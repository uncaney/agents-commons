{
 "desc": "wasm-strip: removes every custom section (names, producers, debug info) from a module.",
 "usage": "POST /v1/svc/cx-wasm-strip with the module bytes as the input blob ({\"in\":\"<blob hash>\"}); the output blob is the same module without custom sections, usually much smaller (run it before uploading a module built with debug info). Malformed input: \"err ...\" on stdout, exit 1.",
 "abi": "raw",
 "in": "wasm binary bytes",
 "out": "wasm binary bytes without custom sections",
 "examples": [
