# Forgejo app.ini overrides (FORGEJO__<section>__<KEY>), loaded via env_file in the server compose.
# Internal-only instance: no Internet egress, reached by the gateway at http://forgejo:3000 only.
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__database__DB_TYPE=sqlite3
FORGEJO__database__PATH=/data/gitea/forgejo.db
FORGEJO__server__ROOT_URL=http://forgejo:3000/
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__DISABLE_SSH=true
FORGEJO__server__START_SSH_SERVER=false
FORGEJO__server__OFFLINE_MODE=true
FORGEJO__server__LFS_START_SERVER=false
FORGEJO__server__ENABLE_GZIP=true
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=false
FORGEJO__service__DEFAULT_ALLOW_CREATE_ORGANIZATION=false
FORGEJO__service__ENABLE_NOTIFY_MAIL=false
FORGEJO__service__SHOW_REGISTRATION_BUTTON=false
FORGEJO__service__ENABLE_CAPTCHA=false
FORGEJO__service__DEFAULT_KEEP_EMAIL_PRIVATE=true
FORGEJO__actions__ENABLED=false
FORGEJO__packages__ENABLED=false
FORGEJO__lfs__ENABLED=false
FORGEJO__mirror__ENABLED=false
FORGEJO__mirror__DISABLE_NEW_PULL=true
FORGEJO__mirror__DISABLE_NEW_PUSH=true
FORGEJO__migrations__ALLOWED_DOMAINS=
FORGEJO__migrations__ALLOW_LOCALNETWORKS=false
FORGEJO__repository__DISABLE_STARS=true
FORGEJO__repository__DISABLE_MIGRATIONS=true
FORGEJO__repository__DISABLE_HTTP_GIT=true
FORGEJO__repository__ENABLE_PUSH_CREATE_USER=false
FORGEJO__repository__ENABLE_PUSH_CREATE_ORG=false
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__repository__DEFAULT_REPO_UNITS=repo.code,repo.issues,repo.wiki
FORGEJO__repository__DISABLED_REPO_UNITS=repo.pulls,repo.projects,repo.releases,repo.packages,repo.actions
FORGEJO__repository.upload__ENABLED=false
FORGEJO__webhook__ALLOWED_HOST_LIST=none
FORGEJO__mailer__ENABLED=false
FORGEJO__openid__ENABLE_OPENID_SIGNIN=false
FORGEJO__openid__ENABLE_OPENID_SIGNUP=false
FORGEJO__oauth2__ENABLED=false
FORGEJO__federation__ENABLED=false
FORGEJO__api__ENABLE_SWAGGER=false
FORGEJO__api__MAX_RESPONSE_ITEMS=50
FORGEJO__api__DEFAULT_PAGING_NUM=50
FORGEJO__cron__ENABLED=true
FORGEJO__cron.repo_health_check__ENABLED=true
FORGEJO__cron.repo_health_check__SCHEDULE=@every 24h
FORGEJO__cron.check_repo_stats__ENABLED=true
FORGEJO__cron.cleanup_hook_task_table__ENABLED=true
FORGEJO__cron.update_mirrors__ENABLED=false
FORGEJO__cron.update_checker__ENABLED=false
FORGEJO__log__LEVEL=Warn
FORGEJO__log__MODE=console
FORGEJO__other__SHOW_FOOTER_VERSION=false
FORGEJO__other__ENABLE_SITEMAP=false
FORGEJO__other__ENABLE_FEED=false
