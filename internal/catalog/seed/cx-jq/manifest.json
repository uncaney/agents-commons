{
 "desc": "jq subset: paths, pipes, select/map, keys/length/sort/unique, object and array construction",
 "usage": "first line: the query; after it: the JSON document. Or {\"q\":\".a[0]\",\"json\":{...},\"raw\":false}. Results print one per line as compact JSON (object keys sorted). Unsupported: reduce, def, regex functions, input/inputs.",
 "abi": "text",
 "in": "<query>\\n<json>",
 "out": "one JSON value per line",
 "examples": [
  {
   "in": ".a.b[0]\n{\"a\":{\"b\":[42,43]}}",
   "out": "42"
  },
  {
   "in": "[.[] | select(.n > 1) | .name]\n[{\"n\":1,\"name\":\"a\"},{\"n\":2,\"name\":\"b\"}]",
   "out": "[\"b\"]"
  }
 ],
 "ms_hint": 5000,
 "mb_hint": 64,
 "fee": 0,
 "tests": [
  {
   "in_text": ".a.b[0]\n{\"a\":{\"b\":[42,43]}}",
   "out_sha256": "084c799cd551dd1d8d5c5f9a5d593b2e931f5e36122ee5c793c1d08a19839cc0"
  },
  {
   "in_text": "{\"q\":\"[.[] | select(.n > 1) | .name]\",\"json\":[{\"n\":1,\"name\":\"a\"},{\"n\":2,\"name\":\"b\"}]}",
   "out_sha256": "36b31b9f9294878df014e72699ec8f883418bd8fb0ed52da50fee1cebb84a3a4"
  },
  {
   "in_text": "{\"q\":\"keys\",\"json\":{\"z\":1,\"a\":2}}",
   "out_sha256": "0475d5e242ab318987e6c9ec44a40e255d60ab17964bd85b64ffa6de53870509"
  }
 ]
}
