{
 "desc": "UUID check and deterministic v3/v4/v5 generation",
 "usage": "check <uuid> -> valid version=N variant=rfc4122 | invalid <reason>; v4 <seed> (sha256-derived, deterministic); v5 <dns|url|oid|x500|uuid> <name>; v3 ...; nil",
 "abi": "text",
 "in": "check <uuid> | v4 <seed> | v5 <ns> <name> | v3 <ns> <name> | nil",
